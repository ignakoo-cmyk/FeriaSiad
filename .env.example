# ─────────────────────────────────────────────────────────────────────
# UAH Face AI Platform — Variables de Entorno
#
# INSTRUCCIONES:
#   1. Copia este archivo:  cp .env.example .env.production
#   2. Rellena los valores reales
#   3. NUNCA commitees .env.production al repositorio
#   4. Agrega .env.production a .gitignore
# ─────────────────────────────────────────────────────────────────────

# Entorno de Node.js
NODE_ENV=production

# Puerto del servidor Express
PORT=3001

# Nivel de logging: error | warn | info | debug
LOG_LEVEL=info

# API Keys para el endpoint /fetch_external_image
# Genera claves seguras con: openssl rand -hex 32
# Múltiples claves separadas por coma (permite rotación sin downtime)
API_KEYS=cambia_esto_con_openssl_rand_hex_32,segunda_clave_opcional

# Contraseña del panel Grafana
GRAFANA_PASSWORD=cambia_esto_por_una_password_segura
